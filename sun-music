<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sun Music</title>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#ff7a00">
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #ff9966, #ff5e62);
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            text-align: center;
        }
        .player-card {
            background: rgba(0, 0, 0, 0.3);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            backdrop-filter: blur(4px);
            width: 90%;
            max-width: 400px;
        }
        h1 {
            margin-bottom: 10px;
            font-size: 2rem;
        }
        p {
            color: #ffe6e6;
            margin-bottom: 25px;
        }
        audio {
            width: 100%;
            margin-top: 15px;
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <div class="player-card">
        <h1>Sun Music</h1>
        <p>Acolhedor e que combina com você</p>
        
        <!-- Substitua o link abaixo pelo link direto da sua música preferida se desejar -->
        <audio controls>
            <source src="https://www.w3schools.com/html/horse.mp3" type="audio/mpeg">
            O seu navegador não suporta áudio.
        </audio>
    </div>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw.js')
                .then(() => console.log('Service Worker registado com sucesso!'))
                .catch((error) => console.log('Erro ao registar Service Worker:', error));
        }
    </script>
</body>
</html>
